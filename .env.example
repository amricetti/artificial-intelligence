# =========================================================================
# Configurações do Joga10-AI (Sistema Multi-Agentes)
# =========================================================================

# 1. Chave da API do Google Gemini (Obrigatório)
GEMINI_API_KEY="COLOQUE_SUA_CHAVE_GEMINI_AQUI"

# 2. Arquitetura LangChain & Multi-Provedores LLM
LLM_PROVIDER="gemini" # Opções: gemini, openai, anthropic, ollama
GEMINI_MODEL="gemini-3.5-flash-lite"
LLM_MODEL="gemini-3.5-flash-lite"

# 3. Engenharia SRE & Segurança
OWNER_NAME="Alan" # Nome do dono com permissão para !sre, !metrics, !dash
USD_TO_BRL=5.65

# 4. Nome Customizado do Bot (ex: Joga10, Prof, Craque, FutBot)
BOT_NAME="Zurg"

# 5. Porta do Servidor Local
PORT=5000

# 6. Filtro do Grupo de WhatsApp
TARGET_GROUP_NAME="Futebol de Quinta"
TARGET_GROUP_ID=

# 7. Limite de Jogadores de Linha
MAX_JOGADORES_LINHA=14

# 8. Agente Financeiro & PIX
VALOR_AVULSO=27.00
VALOR_MENSAL=81.00
CHAVE_PIX="pix@joga10.ai (Banco Joga10 AI)"

# 9. Agente do Tempo (Localização da Quadra)
LATITUDE=-23.5505
LONGITUDE=-46.6333
